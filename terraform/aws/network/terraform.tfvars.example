# 실제 AWS 계정 ID, 리전, 단일 Availability Zone으로 교체한다.
aws_account_id = "123456789012"
aws_region     = "ap-northeast-2"
availability_zone          = "ap-northeast-2a"
database_availability_zone = "ap-northeast-2c"

# 아래 값은 팀에서 확정한 관리 태그 값으로 반드시 교체한다.
owner       = "REPLACE_WITH_TEAM"
data_class  = "REPLACE_WITH_DATA_CLASS"

# 최초 apply 전에 GCP, On-Prem, Pod, Service, VPN CIDR과
# 아래 네트워크 범위가 겹치지 않는지 확인한다.
vpc_cidr = "10.20.0.0/16"

# 향후 Public Load Balancer나 Gateway를 배치할 Public Subnet
public_subnet_cidrs = [
  "10.20.0.0/24",
]

# Control Plane과 Worker를 배치할 Private Subnet
private_subnet_cidrs = [
  "10.20.10.0/24",
]

# RDS DB Subnet Group을 구성할 두 번째 AZ의 Private Subnet
database_private_subnet_cidr = "10.20.20.0/24"

# VPN 또는 관리망 라우팅을 구성한 뒤 해당 CIDR을 추가한다.
# 빈 배열이면 외부 SSH 및 Kubernetes API 접근 규칙이 생성되지 않는다.
management_cidrs = []

# Tailscale 구성 전 EICE를 통한 임시 SSH 접속이 필요할 때 활성화한다.
enable_eice      = false
eice_expires_on = null
