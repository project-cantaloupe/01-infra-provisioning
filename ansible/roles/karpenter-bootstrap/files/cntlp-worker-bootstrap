#!/usr/bin/env bash
set -euo pipefail

umask 077
export AWS_PAGER=""

log() {
  printf '[cntlp-worker-bootstrap] %s\n' "$*"
}

fail() {
  log "ERROR: $*" >&2
  exit 1
}

aws_region=""
tailscale_oauth_secret_id=""
kubeadm_join_secret_id=""
node_name=""
karpenter_node=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --aws-region)
      aws_region="${2:-}"
      shift 2
      ;;
    --tailscale-oauth-secret-id)
      tailscale_oauth_secret_id="${2:-}"
      shift 2
      ;;
    --kubeadm-join-secret-id)
      kubeadm_join_secret_id="${2:-}"
      shift 2
      ;;
    --node-name)
      node_name="${2:-}"
      shift 2
      ;;
    --karpenter-node)
      karpenter_node=true
      shift
      ;;
    *)
      fail "지원하지 않는 인자입니다: $1"
      ;;
  esac
done

[[ "${EUID}" -eq 0 ]] || fail "root 권한으로 실행해야 합니다."
[[ -n "${aws_region}" ]] || fail "--aws-region이 필요합니다."
[[ -n "${tailscale_oauth_secret_id}" ]] || fail "--tailscale-oauth-secret-id가 필요합니다."
[[ -n "${kubeadm_join_secret_id}" ]] || fail "--kubeadm-join-secret-id가 필요합니다."
[[ "${node_name}" =~ ^cntlp-aws-wk-[0-9]{2}$ ]] || fail "Boot Test Node 이름 규칙에 맞지 않습니다."

if [[ -s /etc/kubernetes/kubelet.conf ]]; then
  log "이미 Kubernetes에 가입된 Node입니다."
  exit 0
fi

# Golden AMI의 AWS 기본 hostname을 예약된 Kubernetes Node 이름으로 바꾼다.
# cloud-init 재실행이나 재부팅 후에도 같은 이름을 유지한다.
hostnamectl set-hostname "${node_name}"
cat >/etc/cloud/cloud.cfg.d/99-preserve-hostname.cfg <<'CFG'
preserve_hostname: true
CFG

work_directory="$(mktemp -d /run/cntlp-worker-bootstrap.XXXXXX)"
tailscale_oauth_secret_file="${work_directory}/tailscale-oauth-secret.json"
tailscale_client_secret_file="${work_directory}/tailscale-client-secret"
kubeadm_join_secret_file="${work_directory}/kubeadm-join-secret.json"
tailscale_status_file="${work_directory}/tailscale-status.json"
instance_identity_file="${work_directory}/instance-identity.json"
join_config_file="${work_directory}/kubeadm-join.yaml"

cleanup() {
  rm -rf -- "${work_directory}"
}
trap cleanup EXIT

read_secret() {
  local secret_id="$1"
  local output_file="$2"
  local label="$3"

  log "${label} Secret 조회"
  for attempt in $(seq 1 12); do
    if aws secretsmanager get-secret-value \
      --region "${aws_region}" \
      --secret-id "${secret_id}" \
      --query SecretString \
      --output text >"${output_file}"; then
      return 0
    fi

    if [[ "${attempt}" -eq 12 ]]; then
      fail "${label} Secret을 조회하지 못했습니다."
    fi
    sleep 5
  done
}

read_secret \
  "${tailscale_oauth_secret_id}" \
  "${tailscale_oauth_secret_file}" \
  "Tailscale OAuth"
read_secret \
  "${kubeadm_join_secret_id}" \
  "${kubeadm_join_secret_file}" \
  "kubeadm Join"

python3 - "${tailscale_oauth_secret_file}" "${tailscale_client_secret_file}" <<'PY'
import json
import pathlib
import sys

secret_path = pathlib.Path(sys.argv[1])
client_secret_path = pathlib.Path(sys.argv[2])
secret = json.loads(secret_path.read_text(encoding="utf-8"))

client_secret = str(secret.get("oauth_client_secret", ""))
if not client_secret.startswith("tskey-client-"):
    raise SystemExit("invalid Tailscale OAuth client secret")

client_secret_path.write_text(client_secret, encoding="utf-8")
client_secret_path.chmod(0o600)
PY

python3 - "${kubeadm_join_secret_file}" <<'PY'
import datetime
import json
import pathlib
import re
import sys

secret_path = pathlib.Path(sys.argv[1])
secret = json.loads(secret_path.read_text(encoding="utf-8"))

required = {
    "api_server_endpoint",
    "token",
    "ca_cert_hash",
    "expires_at",
}
missing = sorted(required - secret.keys())
if missing:
    raise SystemExit(f"kubeadm join secret missing fields: {', '.join(missing)}")

if not re.fullmatch(r"[a-z0-9]{6}\.[a-z0-9]{16}", str(secret["token"])):
    raise SystemExit("invalid kubeadm bootstrap token")
if not re.fullmatch(r"sha256:[a-f0-9]{64}", str(secret["ca_cert_hash"])):
    raise SystemExit("invalid kubeadm CA hash")
if not re.fullmatch(r"[^\s:]+:\d{1,5}", str(secret["api_server_endpoint"])):
    raise SystemExit("invalid Kubernetes API endpoint")

expires_at = datetime.datetime.fromisoformat(
    str(secret["expires_at"]).replace("Z", "+00:00")
)
if expires_at <= datetime.datetime.now(datetime.timezone.utc):
    raise SystemExit("kubeadm bootstrap token expired")
PY

log "Tailscale 가입"
systemctl enable --now tailscaled
tailscale up \
  --client-secret="file:${tailscale_client_secret_file}" \
  --hostname="${node_name}" \
  --advertise-tags=tag:cntlp-wk \
  --accept-dns=false \
  --accept-routes=false \
  --ssh \
  --timeout=2m \
  --reset
rm -f -- "${tailscale_oauth_secret_file}" "${tailscale_client_secret_file}"

for attempt in $(seq 1 24); do
  if tailscale status --json >"${tailscale_status_file}"; then
    tailscale_backend="$({
      python3 - "${tailscale_status_file}" <<'PY'
import json
import pathlib
import sys

status = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(status.get("BackendState", ""))
PY
    })"
    [[ "${tailscale_backend}" == "Running" ]] && break
  fi

  if [[ "${attempt}" -eq 24 ]]; then
    fail "Tailscale이 Running 상태가 되지 않았습니다."
  fi
  sleep 5
done

mapfile -t tailscale_identity < <(
  python3 - "${tailscale_status_file}" <<'PY'
import json
import pathlib
import sys

status = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
addresses = status.get("Self", {}).get("TailscaleIPs", [])
ipv4 = next((address for address in addresses if address.startswith("100.")), "")
dns_name = status.get("Self", {}).get("DNSName", "")
print(ipv4)
print(dns_name.split(".", 1)[0])
PY
)

tailscale_ipv4="${tailscale_identity[0]:-}"
tailscale_registered_name="${tailscale_identity[1]:-}"
[[ "${tailscale_ipv4}" =~ ^100\. ]] || fail "Tailscale IPv4를 확인하지 못했습니다."
if [[ "${tailscale_registered_name}" != "${node_name}" ]]; then
  # Karpenter는 같은 예약 이름을 반복 사용한다. 이전 ephemeral Device가 아직
  # tailnet에 남아 있으면 Tailscale이 -1, -2 접미사를 자동으로 붙인다.
  if [[ "${karpenter_node}" != true ]] \
    || [[ ! "${tailscale_registered_name}" =~ ^${node_name}-[0-9]+$ ]]; then
    fail "Tailscale 등록 이름이 허용 범위를 벗어났습니다."
  fi
  log "Tailscale 중복 이름 접미사 허용: ${tailscale_registered_name}"
fi

log "EC2 신원 확인"
imds_token="$({
  curl --fail --silent --show-error --retry 5 \
    --request PUT \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
    http://169.254.169.254/latest/api/token
})"
curl --fail --silent --show-error --retry 5 \
  --header "X-aws-ec2-metadata-token: ${imds_token}" \
  http://169.254.169.254/latest/dynamic/instance-identity/document \
  >"${instance_identity_file}"

python3 - \
  "${kubeadm_join_secret_file}" \
  "${instance_identity_file}" \
  "${join_config_file}" \
  "${node_name}" \
  "${tailscale_ipv4}" \
  "${karpenter_node}" <<'PY'
import json
import pathlib
import sys

join_secret = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
identity = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
output_path = pathlib.Path(sys.argv[3])
node_name = sys.argv[4]
node_ip = sys.argv[5]
karpenter_node = sys.argv[6] == "true"

required_identity = {
    "availabilityZone",
    "instanceId",
    "instanceType",
    "region",
}
missing_identity = sorted(required_identity - identity.keys())
if missing_identity:
    raise SystemExit(f"instance identity missing fields: {', '.join(missing_identity)}")

provider_id = f"aws:///{identity['availabilityZone']}/{identity['instanceId']}"
node_labels = ",".join(
    [
        "platform=aws",
        "role=service",
        f"topology.kubernetes.io/region={identity['region']}",
        f"node.kubernetes.io/instance-type={identity['instanceType']}",
    ]
)

register_with_taints = ""
if karpenter_node:
    register_with_taints = (
        '\n    - name: register-with-taints'
        '\n      value: "karpenter.sh/unregistered:NoExecute"'
    )

config = f"""apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{join_secret['api_server_endpoint']}"
    token: "{join_secret['token']}"
    caCertHashes:
      - "{join_secret['ca_cert_hash']}"
nodeRegistration:
  name: "{node_name}"
  criSocket: unix:///var/run/containerd/containerd.sock
  imagePullPolicy: IfNotPresent
  kubeletExtraArgs:
    - name: node-ip
      value: "{node_ip}"
    - name: node-labels
      value: "{node_labels}"
    - name: provider-id
      value: "{provider_id}"
    - name: image-credential-provider-config
      value: "/etc/kubelet-credential-provider/ecr-credential-provider.yaml"
    - name: image-credential-provider-bin-dir
      value: "/usr/local/libexec/kubelet-credential-providers"{register_with_taints}
"""

output_path.write_text(config, encoding="utf-8")
output_path.chmod(0o600)
PY

rm -f -- "${kubeadm_join_secret_file}"

log "Kubernetes 가입"
kubeadm config validate --config "${join_config_file}"
kubeadm join --config "${join_config_file}"
rm -f -- "${join_config_file}"

systemctl enable --now kubelet
install -d -m 0755 /var/lib/cntlp
printf 'node=%s\n' "${node_name}" >/var/lib/cntlp/bootstrap-complete
chmod 0644 /var/lib/cntlp/bootstrap-complete

log "BOOTSTRAP_OK node=${node_name}"
