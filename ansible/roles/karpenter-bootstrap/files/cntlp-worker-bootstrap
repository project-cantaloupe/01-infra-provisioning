#!/usr/bin/env bash
set -euo pipefail

umask 077
export AWS_PAGER=""

log() {
  printf '[cntlp-worker-bootstrap] %s\n' "$*"
}

fail() {
  log "ERROR: $*" >&2
  exit 1
}

aws_region=""
secret_id=""
node_name=""
karpenter_node=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --aws-region)
      aws_region="${2:-}"
      shift 2
      ;;
    --secret-id)
      secret_id="${2:-}"
      shift 2
      ;;
    --node-name)
      node_name="${2:-}"
      shift 2
      ;;
    --karpenter-node)
      karpenter_node=true
      shift
      ;;
    *)
      fail "지원하지 않는 인자입니다: $1"
      ;;
  esac
done

[[ "${EUID}" -eq 0 ]] || fail "root 권한으로 실행해야 합니다."
[[ -n "${aws_region}" ]] || fail "--aws-region이 필요합니다."
[[ -n "${secret_id}" ]] || fail "--secret-id가 필요합니다."
[[ "${node_name}" =~ ^cntlp-aws-wk-[0-9]{2}$ ]] || fail "Boot Test Node 이름 규칙에 맞지 않습니다."

if [[ -s /etc/kubernetes/kubelet.conf ]]; then
  log "이미 Kubernetes에 가입된 Node입니다."
  exit 0
fi

work_directory="$(mktemp -d /run/cntlp-worker-bootstrap.XXXXXX)"
secret_file="${work_directory}/bootstrap-secret.json"
tailscale_auth_key_file="${work_directory}/tailscale-auth-key"
tailscale_status_file="${work_directory}/tailscale-status.json"
instance_identity_file="${work_directory}/instance-identity.json"
join_config_file="${work_directory}/kubeadm-join.yaml"

cleanup() {
  rm -rf -- "${work_directory}"
}
trap cleanup EXIT

log "Bootstrap Secret 조회"
for attempt in $(seq 1 12); do
  if aws secretsmanager get-secret-value \
    --region "${aws_region}" \
    --secret-id "${secret_id}" \
    --query SecretString \
    --output text >"${secret_file}"; then
    break
  fi

  if [[ "${attempt}" -eq 12 ]]; then
    fail "Bootstrap Secret을 조회하지 못했습니다."
  fi
  sleep 5
done

python3 - "${secret_file}" "${tailscale_auth_key_file}" <<'PY'
import datetime
import json
import pathlib
import re
import sys

secret_path = pathlib.Path(sys.argv[1])
auth_key_path = pathlib.Path(sys.argv[2])
secret = json.loads(secret_path.read_text(encoding="utf-8"))

required = {
    "tailscale_auth_key",
    "api_server_endpoint",
    "token",
    "ca_cert_hash",
    "expires_at",
}
missing = sorted(required - secret.keys())
if missing:
    raise SystemExit(f"bootstrap secret missing fields: {', '.join(missing)}")

if not str(secret["tailscale_auth_key"]).startswith("tskey-"):
    raise SystemExit("invalid Tailscale auth key")
if not re.fullmatch(r"[a-z0-9]{6}\.[a-z0-9]{16}", str(secret["token"])):
    raise SystemExit("invalid kubeadm bootstrap token")
if not re.fullmatch(r"sha256:[a-f0-9]{64}", str(secret["ca_cert_hash"])):
    raise SystemExit("invalid kubeadm CA hash")
if not re.fullmatch(r"[^\s:]+:\d{1,5}", str(secret["api_server_endpoint"])):
    raise SystemExit("invalid Kubernetes API endpoint")

expires_at = datetime.datetime.fromisoformat(
    str(secret["expires_at"]).replace("Z", "+00:00")
)
if expires_at <= datetime.datetime.now(datetime.timezone.utc):
    raise SystemExit("kubeadm bootstrap token expired")

auth_key_path.write_text(str(secret["tailscale_auth_key"]), encoding="utf-8")
auth_key_path.chmod(0o600)
PY

log "Tailscale 가입"
systemctl enable --now tailscaled
tailscale up \
  --auth-key="file:${tailscale_auth_key_file}" \
  --hostname="${node_name}" \
  --advertise-tags=tag:cntlp-wk \
  --accept-dns=false \
  --accept-routes=false \
  --ssh \
  --timeout=2m \
  --reset
rm -f -- "${tailscale_auth_key_file}"

for attempt in $(seq 1 24); do
  if tailscale status --json >"${tailscale_status_file}"; then
    tailscale_backend="$({
      python3 - "${tailscale_status_file}" <<'PY'
import json
import pathlib
import sys

status = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(status.get("BackendState", ""))
PY
    })"
    [[ "${tailscale_backend}" == "Running" ]] && break
  fi

  if [[ "${attempt}" -eq 24 ]]; then
    fail "Tailscale이 Running 상태가 되지 않았습니다."
  fi
  sleep 5
done

mapfile -t tailscale_identity < <(
  python3 - "${tailscale_status_file}" <<'PY'
import json
import pathlib
import sys

status = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
addresses = status.get("Self", {}).get("TailscaleIPs", [])
ipv4 = next((address for address in addresses if address.startswith("100.")), "")
dns_name = status.get("Self", {}).get("DNSName", "")
print(ipv4)
print(dns_name.split(".", 1)[0])
PY
)

tailscale_ipv4="${tailscale_identity[0]:-}"
tailscale_registered_name="${tailscale_identity[1]:-}"
[[ "${tailscale_ipv4}" =~ ^100\. ]] || fail "Tailscale IPv4를 확인하지 못했습니다."
[[ "${tailscale_registered_name}" == "${node_name}" ]] || fail "Tailscale 등록 이름이 바뀌었습니다."

log "EC2 신원 확인"
imds_token="$({
  curl --fail --silent --show-error --retry 5 \
    --request PUT \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
    http://169.254.169.254/latest/api/token
})"
curl --fail --silent --show-error --retry 5 \
  --header "X-aws-ec2-metadata-token: ${imds_token}" \
  http://169.254.169.254/latest/dynamic/instance-identity/document \
  >"${instance_identity_file}"

python3 - \
  "${secret_file}" \
  "${instance_identity_file}" \
  "${join_config_file}" \
  "${node_name}" \
  "${tailscale_ipv4}" \
  "${karpenter_node}" <<'PY'
import json
import pathlib
import sys

secret = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
identity = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
output_path = pathlib.Path(sys.argv[3])
node_name = sys.argv[4]
node_ip = sys.argv[5]
karpenter_node = sys.argv[6] == "true"

required_identity = {
    "availabilityZone",
    "instanceId",
    "instanceType",
    "region",
}
missing_identity = sorted(required_identity - identity.keys())
if missing_identity:
    raise SystemExit(f"instance identity missing fields: {', '.join(missing_identity)}")

provider_id = f"aws:///{identity['availabilityZone']}/{identity['instanceId']}"
node_labels = ",".join(
    [
        "platform=aws",
        "role=service",
        f"topology.kubernetes.io/region={identity['region']}",
        f"node.kubernetes.io/instance-type={identity['instanceType']}",
    ]
)

register_with_taints = ""
if karpenter_node:
    register_with_taints = (
        '\n    - name: register-with-taints'
        '\n      value: "karpenter.sh/unregistered:NoExecute"'
    )

config = f"""apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{secret['api_server_endpoint']}"
    token: "{secret['token']}"
    caCertHashes:
      - "{secret['ca_cert_hash']}"
nodeRegistration:
  name: "{node_name}"
  criSocket: unix:///var/run/containerd/containerd.sock
  imagePullPolicy: IfNotPresent
  kubeletExtraArgs:
    - name: node-ip
      value: "{node_ip}"
    - name: node-labels
      value: "{node_labels}"
    - name: provider-id
      value: "{provider_id}"{register_with_taints}
"""

output_path.write_text(config, encoding="utf-8")
output_path.chmod(0o600)
PY

rm -f -- "${secret_file}"

log "Kubernetes 가입"
kubeadm config validate --config "${join_config_file}"
kubeadm join --config "${join_config_file}"
rm -f -- "${join_config_file}"

systemctl enable --now kubelet
install -d -m 0755 /var/lib/cntlp
printf 'node=%s\n' "${node_name}" >/var/lib/cntlp/bootstrap-complete
chmod 0644 /var/lib/cntlp/bootstrap-complete

log "BOOTSTRAP_OK node=${node_name}"
