aws_account_id = "123456789012"
aws_region     = "ap-northeast-2"

# Use the same team-approved governance metadata as the Network state.
owner       = "REPLACE_WITH_TEAM"
cost_center = "REPLACE_WITH_COST_CENTER"
data_class  = "REPLACE_WITH_DATA_CLASS"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

control_plane_instance_type = "t3.small"
worker_instance_type        = "t3.small"
worker_count                 = 1

root_volume_size = 30
