# API 서버의 사람 인증 설정. Keycloak realm 의 토큰을 검증한다.
#
# ⚠️ **이 파일은 kubeadm 이 만들지 않는다.** 롤이 따로 배치하고,
# apiServer.extraVolumes 로 static pod 에 마운트한다.
#
# ── 왜 --oidc-* 플래그가 아닌가 ────────────────────────────────
#
# **이 파일은 핫 리로드된다.** 플래그는 값을 바꿀 때마다 API 서버를
# 재시작해야 하는데, 컨트롤플레인이 1대라 그때마다 클러스터 조작이 멈춘다
# → decisions/20260803_control-plane-single-node.md
#
# 파일을 쓰면 재시작이 **처음 한 번**뿐이다. 그 뒤로는 파일만 갈면 된다.
#
# ⚠️ **디렉터리를 마운트해야 한다.** 핫 리로드는 파일이 교체될 때
# 일어나는데, 파일 하나를 직접 마운트하면 교체(inode 변경)가 컨테이너
# 안으로 전달되지 않는다.
apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: {{ kubernetes_oidc_issuer_url }}
      audiences:
        # 토큰의 aud 가 이것과 같아야 한다. kubelogin 의
        # --oidc-client-id 가 이 값을 만든다.
        - {{ kubernetes_oidc_client_id }}

    claimMappings:
      # ⚠️ **kubectl 이 보내는 것은 id_token 이다.** access_token 이
      # 아니다. admin-cli 의 lightweight 설정 때문에 access_token 에
      # 클레임이 안 실리는 것을 본 적이 있는데, 이 경로는 무관하다
      # → findings/20260810_admin-cli-lightweight-access-token.md
      username:
        claim: preferred_username
        # ⚠️ **접두사를 반드시 붙인다.** 없으면 OIDC 사용자 이름이
        # ServiceAccount·노드 같은 내장 주체 이름과 충돌할 수 있다.
        # 이 문자열이 RBAC 주체 이름의 일부가 된다.
        prefix: "oidc:"

      groups:
        claim: groups
        prefix: "oidc:"

    # ⚠️ **claimValidationRules 를 두지 않는다.** `email_verified` 로
    # 한 겹 더 막고 싶었지만, 규칙이 하나라도 안 맞으면 **로그인 전체가
    # 막힌다.** 폴백이 break-glass 하나뿐인 도구에서 그 교환은 안 맞는다.
    # realm 가입이 닫혀 있어 임의 계정이 생기지 않는 것으로 대신한다.
