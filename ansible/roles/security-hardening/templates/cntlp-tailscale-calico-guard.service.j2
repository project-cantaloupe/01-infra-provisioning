# Ansible 이 관리한다 — roles/security-hardening/templates/
#
# Tailscale ↔ Calico VXLAN 재귀 루프 가드의 **두 번째 층**이다.
# 첫 번째 층은 ufw before.rules 의 DROP 규칙이고, 이쪽은 라우팅 조회 단계다.
# 왜 둘인지 → decisions/20260806_loop-guard-two-layers.md
#
# fwmark {{ security_tailscale_fwmark }} 는 tailscaled 가 **자기가 만든 패킷**에
# 찍는 bypass 마크다. 이 규칙은 그중 파드 대역으로 가는 것만 골라 경로가 없는
# 것으로 만든다. 마크가 없는 파드 트래픽은 그대로 산다:
#
#   ip route get <파드IP> mark {{ security_tailscale_fwmark.split('/')[0] }}   → Network is unreachable
#   ip route get <파드IP>                                                       → via … dev {{ security_calico_interface }}
[Unit]
Description=Cantaloupe Tailscale-Calico recursion guard
After=network-online.target tailscaled.service
Wants=network-online.target
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
# ExecStartPre 의 `-` 는 실패를 무시하라는 뜻이다. 규칙이 없을 때(최초 부팅)도
# 성공해야 하므로 붙인다. 있으면 지우고 다시 넣어 중복을 막는다.
ExecStartPre=-/usr/sbin/ip rule del pref {{ security_loop_guard_rule_pref }} fwmark {{ security_tailscale_fwmark }} to {{ security_calico_pod_cidr }} unreachable
ExecStart=/usr/sbin/ip rule add pref {{ security_loop_guard_rule_pref }} fwmark {{ security_tailscale_fwmark }} to {{ security_calico_pod_cidr }} unreachable
ExecStop=-/usr/sbin/ip rule del pref {{ security_loop_guard_rule_pref }} fwmark {{ security_tailscale_fwmark }} to {{ security_calico_pod_cidr }} unreachable

[Install]
WantedBy=multi-user.target
