apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ tailscale_ipv4 }}"
  bindPort: {{ kubernetes_control_plane_port }}
nodeRegistration:
  name: "{{ ansible_facts.hostname }}"
  criSocket: "{{ kubernetes_cri_socket }}"
  imagePullPolicy: IfNotPresent
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ tailscale_ipv4 }}"
    - name: node-labels
      value: "platform={{ kubernetes_node_platform }},role={{ kubernetes_node_role }},topology.kubernetes.io/region={{ kubernetes_node_region }},node.kubernetes.io/instance-type={{ kubernetes_node_instance_type }}"
{% if kubernetes_node_provider_id | length > 0 %}
    - name: provider-id
      value: "{{ kubernetes_node_provider_id }}"
{% endif %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "{{ kubernetes_cluster_name }}"
kubernetesVersion: "{{ kubernetes_version }}"
controlPlaneEndpoint: "{{ tailscale_ipv4 }}:{{ kubernetes_control_plane_port }}"
apiServer:
  certSANs:
    - "{{ tailscale_ipv4 }}"
    - "{{ ansible_facts.hostname }}"
  # v1beta4 의 extraArgs 는 맵이 아니라 name/value 목록이다. v1beta3 문법
  # (`service-node-port-range: "..."`)을 쓰면 kubeadm 이 파싱 단계에서 죽는다.
  #
  # 443 을 포함시키는 이유는 vars/cluster.yml 의 같은 이름 변수 옆에 있다.
  extraArgs:
    - name: service-node-port-range
      value: "{{ kubernetes_service_node_port_range }}"
    # 사람 인증. 플래그(--oidc-*)가 아니라 파일을 쓰는 이유는 그 파일이
    # **핫 리로드되기 때문**이다 — 컨트롤플레인이 1대라 재시작이 곧
    # 클러스터 조작 정지다. 파일이면 재시작은 처음 한 번뿐이다.
    - name: authentication-config
      value: "{{ kubernetes_auth_config_dir }}/{{ kubernetes_auth_config_file }}"
  # ⚠️ **파일이 아니라 디렉터리를 마운트한다.** 핫 리로드는 파일 교체로
  # 일어나는데, 파일을 직접 마운트하면 inode 가 바뀌어도 컨테이너 안으로
  # 전달되지 않는다.
  extraVolumes:
    - name: authentication-config
      hostPath: "{{ kubernetes_auth_config_dir }}"
      mountPath: "{{ kubernetes_auth_config_dir }}"
      readOnly: true
      pathType: DirectoryOrCreate
networking:
  dnsDomain: "{{ kubernetes_dns_domain }}"
  serviceSubnet: "{{ kubernetes_service_cidr }}"
  podSubnet: "{{ kubernetes_pod_cidr }}"
---
# Metrics Server가 kubelet의 10250 HTTPS 인증서를 검증할 수 있게 한다.
# kubelet-serving CSR은 kube-controller-manager가 자동 승인하지 않는다.
# 노드명과 SAN을 검증한 뒤 운영자가 승인해야 인증서가 발급된다.
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
serverTLSBootstrap: true
