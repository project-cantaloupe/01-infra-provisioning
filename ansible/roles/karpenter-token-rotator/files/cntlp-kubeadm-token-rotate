#!/usr/bin/env bash
set -euo pipefail

umask 077
export AWS_PAGER=""

log() {
  printf '[cntlp-kubeadm-token-rotate] %s\n' "$*"
}

fail() {
  log "ERROR: $*" >&2
  exit 1
}

aws_region=""
secret_id=""
token_ttl="24h"
secret_valid_seconds="82800"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --aws-region)
      aws_region="${2:-}"
      shift 2
      ;;
    --secret-id)
      secret_id="${2:-}"
      shift 2
      ;;
    --token-ttl)
      token_ttl="${2:-}"
      shift 2
      ;;
    --secret-valid-seconds)
      secret_valid_seconds="${2:-}"
      shift 2
      ;;
    *)
      fail "지원하지 않는 인자입니다: $1"
      ;;
  esac
done

[[ "${EUID}" -eq 0 ]] || fail "root 권한으로 실행해야 합니다."
[[ -n "${aws_region}" ]] || fail "--aws-region이 필요합니다."
[[ -n "${secret_id}" ]] || fail "--secret-id가 필요합니다."
[[ "${token_ttl}" =~ ^[1-9][0-9]*[mh]$ ]] || fail "--token-ttl 형식이 올바르지 않습니다."
[[ "${secret_valid_seconds}" =~ ^[1-9][0-9]*$ ]] || fail "--secret-valid-seconds 형식이 올바르지 않습니다."

for command_name in aws kubeadm python3; do
  command -v "${command_name}" >/dev/null || fail "필수 명령을 찾지 못했습니다: ${command_name}"
done
[[ -s /etc/kubernetes/admin.conf ]] || fail "Control Plane kubeconfig를 찾지 못했습니다."

work_directory="$(mktemp -d /run/cntlp-kubeadm-token-rotate.XXXXXX)"
join_command_file="${work_directory}/join-command"
secret_value_file="${work_directory}/secret-value.json"
token_id=""
stored=false

cleanup() {
  exit_code=$?
  trap - EXIT
  rm -rf -- "${work_directory}"

  if [[ "${stored}" != true && -n "${token_id}" ]]; then
    kubeadm token delete "${token_id}" >/dev/null 2>&1 || true
  fi

  exit "${exit_code}"
}
trap cleanup EXIT

log "새 kubeadm bootstrap token 생성"
kubeadm token create \
  --ttl="${token_ttl}" \
  --description cntlp-karpenter-worker \
  --print-join-command >"${join_command_file}"

token_id="$(
  python3 - "${join_command_file}" "${secret_value_file}" "${secret_valid_seconds}" <<'PY'
import datetime
import json
import pathlib
import re
import shlex
import sys

parts = shlex.split(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
output_path = pathlib.Path(sys.argv[2])
valid_seconds = int(sys.argv[3])

try:
    join_index = parts.index("join")
    endpoint = parts[join_index + 1]
    token = parts[parts.index("--token") + 1]
    ca_hash = parts[parts.index("--discovery-token-ca-cert-hash") + 1]
except (ValueError, IndexError) as error:
    raise SystemExit("kubeadm join command parse failed") from error

if not re.fullmatch(r"[^\s:]+:\d{1,5}", endpoint):
    raise SystemExit("invalid Kubernetes API endpoint")
if not re.fullmatch(r"[a-z0-9]{6}\.[a-z0-9]{16}", token):
    raise SystemExit("invalid kubeadm bootstrap token")
if not re.fullmatch(r"sha256:[a-f0-9]{64}", ca_hash):
    raise SystemExit("invalid kubeadm CA hash")

expires_at = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(
    seconds=valid_seconds
)
secret = {
    "api_server_endpoint": endpoint,
    "token": token,
    "ca_cert_hash": ca_hash,
    "expires_at": expires_at.isoformat().replace("+00:00", "Z"),
}
output_path.write_text(json.dumps(secret, separators=(",", ":")), encoding="utf-8")
output_path.chmod(0o600)
print(token.split(".", 1)[0])
PY
)"

log "kubeadm Join Secret 갱신"
aws secretsmanager put-secret-value \
  --region "${aws_region}" \
  --secret-id "${secret_id}" \
  --secret-string "file://${secret_value_file}" \
  --query VersionId \
  --output text >/dev/null

stored=true
log "ROTATION_OK"
