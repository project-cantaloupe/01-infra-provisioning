# 실제 AWS 계정 ID와 Network 상태에서 사용한 리전을 입력한다.
aws_account_id = "123456789012"
aws_region     = "ap-northeast-2"

# Network 상태와 동일한 팀 관리 태그 값을 사용한다.
owner       = "REPLACE_WITH_TEAM"
cost_center = "REPLACE_WITH_COST_CENTER"
data_class  = "REPLACE_WITH_DATA_CLASS"

# AWS EC2 Key Pair에 등록할 로컬 SSH 공개키 경로
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# 단일 Control Plane과 단일 Worker PoC의 기본 사양
control_plane_instance_type = "t3.small"
worker_instance_type        = "t3.small"
worker_count                 = 1

# 모든 노드의 암호화된 gp3 Root EBS 크기(GiB)
root_volume_size = 30
